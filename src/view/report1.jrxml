	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    r.ReservationID,
    r.ReservationDate,
    g.GuestName,
    g.Contact,
    g.Email,
    rm.RoomName,
    rm.RoomType,
    rm.PricePerNight,
    r.TotalPrice

FROM Reservations r

INNER JOIN Guests g
    ON r.GuestID = g.GuestID

INNER JOIN room rm
    ON r.RoomID = rm.RoomID

ORDER BY r.ReservationDate DESC, r.ReservationID DESC;]]>
	</queryString>
